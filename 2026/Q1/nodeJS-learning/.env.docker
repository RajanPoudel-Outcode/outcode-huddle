# Docker Environment Configuration
NODE_ENV=development
PORT=3000

# MongoDB connection string for Docker Compose
MONGO_URL=mongodb://mongo:27017/nodeLearning?retryWrites=true&w=majority

# Prisma Database URL
DATABASE_URL=mongodb://mongo:27017/nodeLearning?replicaSet=rs0&retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=passwordKey

# Frontend URL(home network IP address of the machine running the Docker container)
FRONTEND_URL=http://192.168.1.3:3001

# Fontend URL(office network IP address of the machine running the Docker container)
# FRONTEND_URL_OFFICE=http://192.168.10.104:3000
